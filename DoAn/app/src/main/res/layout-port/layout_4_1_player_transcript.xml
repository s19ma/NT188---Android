<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8FAFC">

    <!-- VIDEO PLAYER HEADER WITH BACK BUTTON -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#FF0F172A">

        <androidx.media3.ui.PlayerView
            android:id="@+id/video_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerInParent="true"
            app:show_buffering="when_playing"
            app:use_controller="true" />

        <!-- BACK BUTTON -->
        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="36sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_player_video_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#990F172A"
            android:padding="12dp"
            android:text="How to Speak Like a Native"
            android:textSize="15sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:fontFamily="Inter" />
    </RelativeLayout>

    <!-- SCROLLABLE TRANSCRIPT & ACTIONS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_bar"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tab_transcript"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Transcript"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_selected"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tab_summary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Tóm tắt"
                    android:gravity="center"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tab_vocab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Từ vựng"
                    android:gravity="center"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/transcript_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#475569" />

            <LinearLayout
                android:id="@+id/transcript_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FAFC">

    <!-- Frame: 3.2 Cập nhật mật khẩu thành công (390x844) -->

    <!-- TEXT: ‹ Quay lại -->
    <TextView
        android:text="‹ Quay lại"
        android:textSize="20sp"
        android:textColor="#FF4F46E5"
        android:gravity="start"
        android:textStyle="bold"
        android:fontFamily="Inter"
        android:layout_width="90dp"
        android:layout_height="24dp" />

    <!-- FRAME: Box -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="390dp"
        android:layout_height="806dp"
        android:paddingLeft="20dp"
        android:paddingTop="52dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <!-- TEXT: Cập nhật mật khẩu thành công -->
        <TextView
            android:text="Cập nhật mật khẩu thành công"
            android:textSize="36sp"
            android:textColor="#FF0088FF"
            android:gravity="center_horizontal"
            android:textStyle="bold"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="88dp" />

        <!-- RECTANGLE: ung-dung-di-dong-tai-khoan-dang-ky-thanh-cong-dang-nhap-thanh-cong-qua-dien-thoai-thong-minh_1027249-251 1 -->
        <LinearLayout
        android:layout_width="266dp"
        android:layout_height="266dp" />

        <!-- FRAME: Box -->
        <LinearLayout
            android:orientation="vertical"
        android:layout_width="350dp"
        android:layout_height="46dp"
            android:background="@drawable/bg_rounded_box"
            android:paddingLeft="0dp"
            android:paddingTop="14dp"
            android:paddingRight="0dp"
            android:paddingBottom="14dp">

            <!-- TEXT: Quay lại trang đăng nhập -->
            <TextView
                android:text="Quay lại  trang đăng nhập"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="185dp"
        android:layout_height="18dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
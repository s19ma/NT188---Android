<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <!-- Frame: 28. Chi tiết video (Admin) (390x844) -->

    <!-- FRAME: Box -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="390dp"
        android:layout_height="844dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#FFFFFFFF">

        <!-- FRAME: Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="390dp"
        android:layout_height="64dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="#FFFFFFFF">

            <!-- TEXT: Back -->
            <TextView
                android:text="‹"
                android:textSize="24sp"
                android:textColor="#FF4F45E5"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="20dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Title -->
            <TextView
                android:text="Quản lý video"
                android:textSize="15sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Video preview -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="176dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="82dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Play -->
            <TextView
                android:text="▶"
                android:textSize="42sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center_horizontal"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="50dp"
        android:layout_height="100dp"
        android:layout_marginStart="150dp"
        android:layout_marginTop="66dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- TEXT: Title -->
        <TextView
            android:text="Healthy Living Habits"
            android:textSize="16sp"
            android:textColor="#FF0F1729"
            android:gravity="start"
            android:textStyle="bold"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="278dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- TEXT: Metadata -->
        <TextView
            android:text="Tải lên: 10/05/2025 · 3.2K lượt xem"
            android:textSize="11sp"
            android:textColor="#FF63738C"
            android:gravity="start"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="302dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- FRAME: Box -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="84dp"
        android:layout_height="24dp"
        android:layout_marginStart="286dp"
        android:layout_marginTop="278dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Bị báo cáo -->
            <TextView
                android:text="Bị báo cáo"
                android:textSize="10sp"
                android:textColor="#FFF24057"
                android:gravity="center_horizontal"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="74dp"
        android:layout_height="100dp"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Uploader information -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="96dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="336dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Title -->
            <TextView
                android:text="Thông tin người đăng"
                android:textSize="12sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Content -->
            <TextView
                android:text="user123
Thành viên · 2 tháng"
                android:textSize="12sp"
                android:textColor="#FF63738C"
                android:gravity="start"
                android:fontFamily="Inter"
        android:layout_width="230dp"
        android:layout_height="100dp"
        android:layout_marginStart="56dp"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Report card -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="176dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="452dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Title -->
            <TextView
                android:text="Báo cáo"
                android:textSize="12sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="300dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Content -->
            <TextView
                android:text="Lý do:      Nội dung không phù hợp
Thời gian:  21/05/2025 · 14:32
Mô tả:       Video có nội dung không phù hợp với chính sách cộng đồng."
                android:textSize="12sp"
                android:textColor="#FF63738C"
                android:gravity="start"
                android:fontFamily="Inter"
        android:layout_width="320dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="42dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Delete button -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="166dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="704dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Xóa video -->
            <TextView
                android:text="Xóa video"
                android:textSize="13sp"
                android:textColor="#FF4F45E5"
                android:gravity="center_horizontal"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="11dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Resolve button -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="166dp"
        android:layout_height="40dp"
        android:layout_marginStart="204dp"
        android:layout_marginTop="704dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Xử lý báo cáo -->
            <TextView
                android:text="Xử lý báo cáo"
                android:textSize="13sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center_horizontal"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="11dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
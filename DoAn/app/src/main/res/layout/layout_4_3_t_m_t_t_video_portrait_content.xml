<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8FAFC">

    <!-- VIDEO PLAYER HEADER WITH BACK BUTTON -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="#FF0F172A">

        <!-- BACK BUTTON -->
        <TextView
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="36sp"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- CENTER PLAYER INFO -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▶"
                android:textSize="36sp"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tv_player_video_title"
                android:text="How to Speak Like a Native"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:fontFamily="Inter"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- SCROLLABLE SUMMARY & ACTIONS -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- TABS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_bar"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tab_transcript"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Transcript"
                    android:gravity="center"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tab_summary"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Tóm tắt"
                    android:gravity="center"
                    android:background="@drawable/bg_chip_selected"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tab_vocab"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Từ vựng"
                    android:gravity="center"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- CARD 1: CHỦ ĐỀ CHÍNH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHỦ ĐỀ CHÍNH"
                    android:textSize="11sp"
                    android:textColor="#FF4F46E5"
                    android:textStyle="bold"
                    android:fontFamily="Inter"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/summary_topic"
                    android:text="Đang tải nội dung từ transcript…"
                    android:textSize="16sp"
                    android:textColor="#FF0F172A"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />
            </LinearLayout>

            <!-- CARD 2: Ý CHÍNH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ý chính"
                    android:textSize="15sp"
                    android:textColor="#FF0F172A"
                    android:textStyle="bold"
                    android:fontFamily="Inter"
                    android:layout_marginBottom="8dp" />

                <TextView android:id="@+id/summary_point_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang tải…" android:textSize="14sp" android:textColor="#FF334155" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/summary_point_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FF334155" android:layout_marginBottom="4dp" />
                <TextView android:id="@+id/summary_point_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FF334155" />
            </LinearLayout>

            <!-- CARD 3: CHAPTERS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="2dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chapters"
                    android:textSize="15sp"
                    android:textColor="#FF0F172A"
                    android:textStyle="bold"
                    android:fontFamily="Inter"
                    android:layout_marginBottom="8dp" />

                <TextView android:id="@+id/summary_chapter_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Đang tải…" android:textSize="14sp" android:textColor="#FF4F46E5" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <TextView android:id="@+id/summary_chapter_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FF4F46E5" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <TextView android:id="@+id/summary_chapter_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="14sp" android:textColor="#FF4F46E5" android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <!-- Frame: 5.3. Xác nhận xóa video (390x877) -->

    <!-- FRAME: Box -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="390dp"
        android:layout_height="844dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#FFFFFFFF">

        <!-- FRAME: Video preview -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="184dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="82dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Play -->
            <TextView
                android:text="▶"
                android:textSize="42sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center_horizontal"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="50dp"
        android:layout_height="100dp"
        android:layout_marginStart="150dp"
        android:layout_marginTop="70dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- TEXT: Video title -->
        <TextView
            android:text="The Importance of Time Management"
            android:textSize="16sp"
            android:textColor="#FF0F1729"
            android:gravity="start"
            android:textStyle="bold"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="284dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- TEXT: Metadata -->
        <TextView
            android:text="12:45 · 432 lượt xem"
            android:textSize="11sp"
            android:textColor="#FF63738C"
            android:gravity="start"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="308dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- FRAME: Delete confirmation modal -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="174dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="380dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Warning icon -->
            <TextView
                android:text="!"
                android:textSize="22sp"
                android:textColor="#FFF24057"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="22dp"
        android:layout_height="100dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Title -->
            <TextView
                android:text="Bạn có chắc chắn muốn xóa video này?"
                android:textSize="13sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="280dp"
        android:layout_height="100dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Message -->
            <TextView
                android:text="Video sẽ bị xóa khỏi thư viện và không thể khôi phục."
                android:textSize="11sp"
                android:textColor="#FF63738C"
                android:gravity="start"
                android:fontFamily="Inter"
        android:layout_width="270dp"
        android:layout_height="100dp"
        android:layout_marginStart="50dp"
        android:layout_marginTop="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- FRAME: Confirm delete button -->
            <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="326dp"
        android:layout_height="36dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="104dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/bg_rounded_box">

                <!-- TEXT: Xóa -->
                <TextView
                    android:text="Xóa"
                    android:textSize="13sp"
                    android:textColor="#FFFFFFFF"
                    android:gravity="center_horizontal"
                    android:textStyle="bold"
                    android:fontFamily="Inter"
        android:layout_width="310dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Cancel button -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="38dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="570dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Hủy -->
            <TextView
                android:text="Hủy"
                android:textSize="13sp"
                android:textColor="#FF4F45E5"
                android:gravity="center_horizontal"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="334dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="137dp"
        android:layout_height="64dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="#FFFFFFFF">

            <!-- TEXT: Back -->
            <TextView
                android:text="‹"
                android:textSize="24sp"
                android:textColor="#FF4F45E5"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="20dp"
        android:layout_height="100dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Title -->
            <TextView
                android:text="Xoá video"
                android:textSize="15sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Action -->
            <TextView
                android:text="✎"
                android:textSize="12sp"
                android:textColor="#FF4F45E5"
                android:gravity="end"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="54dp"
        android:layout_height="100dp"
        android:layout_marginStart="316dp"
        android:layout_marginTop="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
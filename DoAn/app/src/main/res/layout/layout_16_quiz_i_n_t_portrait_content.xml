<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FAFC">

    <!-- HEADER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TEXT: Back -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textSize="24sp"
            android:textColor="#FF4F45E5"
            android:textStyle="bold"
            android:fontFamily="Inter"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- TEXT: Action -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✎"
            android:textSize="14sp"
            android:textColor="#FF4F45E5"
            android:textStyle="bold"
            android:fontFamily="Inter"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- CONTENT CONTAINER -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TEXT: Quiz · Câu 3/5 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quiz · Câu 3/5"
            android:textSize="20sp"
            android:textColor="#FF0F172A"
            android:textStyle="bold"
            android:fontFamily="Inter"
            android:layout_marginBottom="12dp" />

        <!-- PROGRESS BAR CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:background="@drawable/bg_rounded_box"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- PROGRESS FILL -->
            <View
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_box" />
        </LinearLayout>

        <!-- CHIP: Fill-in-the-blank -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_box"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fill-in-the-blank"
                android:textSize="11sp"
                android:textColor="#FF4F46E5"
                android:textStyle="bold"
                android:fontFamily="Inter" />
        </LinearLayout>

        <!-- QUESTION CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rounded_box"
            android:orientation="vertical"
            android:padding="18dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Small habits create big ______ over time."
                android:textSize="17sp"
                android:textColor="#FF0F172A"
                android:textStyle="bold"
                android:fontFamily="Inter" />
        </LinearLayout>

        <!-- ANSWER INPUT SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐIỀN TỪ CÒN THIẾU"
                android:textSize="12sp"
                android:textColor="#FF64748B"
                android:textStyle="bold"
                android:fontFamily="Inter"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_box"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhập đáp án..."
                    android:textSize="15sp"
                    android:textColor="#FF94A3B8"
                    android:fontFamily="Inter" />
            </LinearLayout>
        </LinearLayout>

        <!-- OPTIONS CHIPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_box"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="changes"
                    android:textSize="13sp"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_box"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="results"
                    android:textSize="13sp"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rounded_box"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="lessons"
                    android:textSize="13sp"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />
            </LinearLayout>
        </LinearLayout>

        <!-- SPACER -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- CHECK BUTTON -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_rounded_box"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kiểm tra"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:textStyle="bold"
                android:fontFamily="Inter" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

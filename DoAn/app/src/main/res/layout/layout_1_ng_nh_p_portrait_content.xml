<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="32dp">

            <!-- LOGO / ICON -->
            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_card_primary"
                android:gravity="center"
                android:elevation="4dp"
                android:layout_marginBottom="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EN"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />
            </LinearLayout>

            <!-- TITLE -->
            <TextView
                android:text="English Through Video"
                android:textSize="26sp"
                android:textColor="#FF0F172A"
                android:gravity="center"
                android:textStyle="bold"
                android:fontFamily="Inter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp" />

            <!-- SUBTITLE -->
            <TextView
                android:text="Học tiếng Anh qua video, từ vựng theo ngữ cảnh"
                android:textSize="14sp"
                android:textColor="#FF64748B"
                android:gravity="center"
                android:fontFamily="Inter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp" />

            <!-- EMAIL FIELD BLOCK -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">

                <TextView
                    android:text="EMAIL / TÀI KHOẢN"
                    android:textSize="12sp"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:fontFamily="Inter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <EditText
                        android:id="@+id/et_email"
                        android:hint="Nhập email của bạn"
                        android:textSize="15sp"
                        android:textColor="#FF0F172A"
                        android:textColorHint="#FF94A3B8"
                        android:background="@null"
                        android:inputType="textEmailAddress"
                        android:fontFamily="Inter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </LinearLayout>

            <!-- PASSWORD FIELD BLOCK -->
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:text="MẬT KHẨU"
                    android:textSize="12sp"
                    android:textColor="#FF64748B"
                    android:textStyle="bold"
                    android:fontFamily="Inter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_search_bar"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <EditText
                        android:id="@+id/et_password"
                        android:hint="Nhập mật khẩu"
                        android:textSize="15sp"
                        android:textColor="#FF0F172A"
                        android:textColorHint="#FF94A3B8"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:fontFamily="Inter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </LinearLayout>
            </LinearLayout>

            <!-- FORGOT PASSWORD -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:layout_marginBottom="28dp">

                <TextView
                    android:id="@+id/tv_forgot_password"
                    android:text="Quên mật khẩu?"
                    android:textSize="13sp"
                    android:textColor="#FF4F46E5"
                    android:textStyle="bold"
                    android:fontFamily="Inter"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- LOGIN BUTTON -->
            <LinearLayout
                android:id="@+id/btn_login"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_card_primary"
                android:gravity="center"
                android:elevation="2dp"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp">

                <TextView
                    android:text="Đăng nhập"
                    android:textSize="16sp"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="Inter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- REGISTER PROMPT -->
            <TextView
                android:id="@+id/tv_register"
                android:text="Chưa có tài khoản?  Đăng ký"
                android:textSize="14sp"
                android:textColor="#FF64748B"
                android:gravity="center"
                android:fontFamily="Inter"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

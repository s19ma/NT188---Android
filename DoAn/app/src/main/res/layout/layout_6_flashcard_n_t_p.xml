<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottom_navigation">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ôn tập Flashcard"
                android:textSize="22sp"
                android:textColor="#FF0F172A"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_flashcard_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thẻ 1 / 4"
                    android:textSize="14sp"
                    android:textColor="#FF4F46E5"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/btn_delete_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗑 Xóa"
                    android:textSize="12sp"
                    android:textColor="#FFEF4444"
                    android:background="@drawable/bg_button_danger"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_flashcard"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:progressTint="#FF4F46E5"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/card_flashcard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card_white"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:elevation="4dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_flashcard_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="resilient"
                android:textSize="32sp"
                android:textColor="#FF0F172A"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_flashcard_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textColor="#FF64748B" />

            <TextView
                android:id="@+id/btn_speak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 Nghe phát âm"
                android:textSize="13sp"
                android:textColor="#FF4F46E5"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:textStyle="bold"
                android:clickable="true"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:id="@+id/tv_flashcard_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Chạm vào thẻ để xem nghĩa"
                android:textSize="13sp"
                android:textColor="#FF94A3B8" />
        </LinearLayout>

        <!-- SPACED REPETITION RATING BUTTONS WITH INTERVALS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal">

            <!-- AGAIN BUTTON -->
            <LinearLayout
                android:id="@+id/btn_again"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lặp lại"
                    android:textSize="13sp"
                    android:textColor="#FFEF4444"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 phút"
                    android:textSize="10sp"
                    android:textColor="#FFEF4444"
                    android:fontFamily="Inter" />
            </LinearLayout>

            <!-- HARD BUTTON -->
            <LinearLayout
                android:id="@+id/btn_hard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khó"
                    android:textSize="13sp"
                    android:textColor="#FFF59E0B"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />

                <TextView
                    android:id="@+id/tv_hard_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theo lịch"
                    android:textSize="10sp"
                    android:textColor="#FFF59E0B"
                    android:fontFamily="Inter" />
            </LinearLayout>

            <!-- GOOD BUTTON -->
            <LinearLayout
                android:id="@+id/btn_good"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tv_good_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tốt"
                    android:textSize="13sp"
                    android:textColor="#FF22C55E"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />

                <TextView
                    android:id="@+id/tv_good_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theo lịch"
                    android:textSize="10sp"
                    android:textColor="#FF22C55E"
                    android:fontFamily="Inter" />
            </LinearLayout>

            <!-- EASY BUTTON -->
            <LinearLayout
                android:id="@+id/btn_easy"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dễ"
                    android:textSize="13sp"
                    android:textColor="#FFFFFFFF"
                    android:textStyle="bold"
                    android:fontFamily="Inter" />

                <TextView
                    android:id="@+id/tv_easy_interval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Theo lịch"
                    android:textSize="10sp"
                    android:textColor="#FFFFFFFF"
                    android:fontFamily="Inter" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- BOTTOM NAV WITH VECTOR ICONS -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:background="#FFFFFFFF"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="3dp" android:src="@drawable/ic_nav_home" android:contentDescription="nav_home"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Home" android:textSize="11sp" android:textColor="#FF64748B" android:fontFamily="Inter" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_vocabulary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="3dp" android:src="@drawable/ic_nav_vocab" android:contentDescription="nav_vocabulary"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Từ vựng" android:textSize="11sp" android:textColor="#FF64748B" android:fontFamily="Inter" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_flashcard" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="3dp" android:src="@drawable/ic_nav_flashcard" android:contentDescription="nav_flashcard"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ôn tập" android:textSize="11sp" android:textColor="#FF4F46E5" android:textStyle="bold" android:fontFamily="Inter" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_progress" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="3dp" android:src="@drawable/ic_nav_progress" android:contentDescription="nav_progress"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tiến độ" android:textSize="11sp" android:textColor="#FF64748B" android:fontFamily="Inter" />
        </LinearLayout>

        <LinearLayout android:id="@+id/nav_profile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:clickable="true" android:focusable="true" android:orientation="vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_marginBottom="3dp" android:src="@drawable/ic_nav_profile" android:contentDescription="nav_profile"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hồ sơ" android:textSize="11sp" android:textColor="#FF64748B" android:fontFamily="Inter" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FAFC">

    <!-- Frame: 3.2 Đặt lại mật khẩu (390x844) -->

    <!-- TEXT: ‹ Quay lại -->
    <TextView
        android:text="‹ Quay lại"
        android:textSize="20sp"
        android:textColor="#FF4F46E5"
        android:gravity="start"
        android:textStyle="bold"
        android:fontFamily="Inter"
        android:layout_width="90dp"
        android:layout_height="24dp" />

    <!-- FRAME: Box -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="390dp"
        android:layout_height="516dp"
        android:paddingLeft="20dp"
        android:paddingTop="50dp"
        android:paddingRight="20dp"
        android:paddingBottom="20dp">

        <!-- TEXT: Đặt lại mật khẩu -->
        <TextView
            android:text="Đặt lại mật khẩu"
            android:textSize="40sp"
            android:textColor="#FF0088FF"
            android:gravity="center_horizontal"
            android:textStyle="bold"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="48dp" />

        <!-- GROUP: Group 5 -->
        <View
        android:layout_width="319dp"
        android:layout_height="193dp" />

        <!-- FRAME: Box -->
        <LinearLayout
            android:orientation="vertical"
        android:layout_width="350dp"
        android:layout_height="46dp"
            android:background="@drawable/bg_rounded_box"
            android:paddingLeft="0dp"
            android:paddingTop="14dp"
            android:paddingRight="0dp"
            android:paddingBottom="14dp">

            <!-- TEXT: Tiếp tục -->
            <TextView
                android:text="Tiếp tục"
                android:textSize="15sp"
                android:textColor="#FFFFFFFF"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="60dp"
        android:layout_height="18dp" />
        </LinearLayout>

        <!-- TEXT: Đã có tài khoản? Đăng nhập ngay! -->
        <TextView
            android:text="Đã có tài khoản? Đăng nhập ngay!"
            android:textSize="16sp"
            android:textColor="#FF0088FF"
            android:gravity="start"
            android:textStyle="italic"
            android:fontFamily="Arial"
        android:layout_width="247dp"
        android:layout_height="18dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
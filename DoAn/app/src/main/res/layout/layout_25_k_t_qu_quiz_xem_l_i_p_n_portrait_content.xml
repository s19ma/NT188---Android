<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFFFF">

    <!-- Frame: 25. Kết quả quiz & xem lại đáp án (390x844) -->

    <!-- FRAME: Box -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="390dp"
        android:layout_height="844dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="#FFFFFFFF">

        <!-- FRAME: Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="390dp"
        android:layout_height="64dp"
        android:layout_marginStart="0dp"
        android:layout_marginTop="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="#FFFFFFFF">

            <!-- TEXT: Back -->
            <TextView
                android:text="‹"
                android:textSize="24sp"
                android:textColor="#FF4F45E5"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="20dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Title -->
            <TextView
                android:text="Kết quả bài kiểm tra"
                android:textSize="15sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="250dp"
        android:layout_height="100dp"
        android:layout_marginStart="48dp"
        android:layout_marginTop="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ELLIPSE: Score circle -->
        <ImageView
            android:src="@drawable/ic_score_circle"
            android:scaleType="fitXY"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_marginStart="130dp"
        android:layout_marginTop="82dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- TEXT: Score -->
        <TextView
            android:text="80"
            android:textSize="36sp"
            android:textColor="#FF4F45E5"
            android:gravity="center_horizontal"
            android:textStyle="bold"
            android:fontFamily="Inter"
        android:layout_width="94dp"
        android:layout_height="100dp"
        android:layout_marginStart="148dp"
        android:layout_marginTop="116dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- TEXT: Score label -->
        <TextView
            android:text="8/10 đúng"
            android:textSize="11sp"
            android:textColor="#FF63738C"
            android:gravity="center_horizontal"
            android:fontFamily="Inter"
        android:layout_width="94dp"
        android:layout_height="100dp"
        android:layout_marginStart="148dp"
        android:layout_marginTop="158dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- TEXT: Duration -->
        <TextView
            android:text="Thời gian làm bài                                         04:32"
            android:textSize="11sp"
            android:textColor="#FF63738C"
            android:gravity="start"
            android:textStyle="bold"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="236dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- TEXT: Stats -->
        <TextView
            android:text="Số câu đúng                                                   8
Số câu sai                                                      2"
            android:textSize="11sp"
            android:textColor="#FF63738C"
            android:gravity="start"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="262dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- FRAME: Retry button -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="166dp"
        android:layout_height="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="320dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Làm lại -->
            <TextView
                android:text="Làm lại"
                android:textSize="13sp"
                android:textColor="#FF4F45E5"
                android:gravity="center_horizontal"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="11dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Watch video button -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="166dp"
        android:layout_height="40dp"
        android:layout_marginStart="204dp"
        android:layout_marginTop="320dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Về video -->
            <TextView
                android:text="Về video"
                android:textSize="13sp"
                android:textColor="#FFFFFFFF"
                android:gravity="center_horizontal"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="11dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- TEXT: Section title -->
        <TextView
            android:text="Xem lại đáp án"
            android:textSize="14sp"
            android:textColor="#FF0F1729"
            android:gravity="start"
            android:textStyle="bold"
            android:fontFamily="Inter"
        android:layout_width="350dp"
        android:layout_height="100dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="390dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

        <!-- FRAME: Question review -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="74dp"

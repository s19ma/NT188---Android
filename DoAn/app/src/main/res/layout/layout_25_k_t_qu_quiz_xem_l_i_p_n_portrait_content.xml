            <!-- TEXT: Question -->
            <TextView
                android:text="1. What is the main idea of the video?"
                android:textSize="11sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="285dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Answer -->
            <TextView
                android:text="Đúng"
                android:textSize="10sp"
                android:textColor="#FF2EAB6B"
                android:gravity="start"
                android:fontFamily="Inter"
        android:layout_width="260dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: State -->
            <TextView
                android:text="✓ Đúng"
                android:textSize="10sp"
                android:textColor="#FF2EAB6B"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="58dp"
        android:layout_height="100dp"
        android:layout_marginStart="280dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Question review -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="74dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="506dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Question -->
            <TextView
                android:text="2. Which of the following is NOT a time waster?"
                android:textSize="11sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="285dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Answer -->
            <TextView
                android:text="C. Reading books"
                android:textSize="10sp"
                android:textColor="#FFF24057"
                android:gravity="start"
                android:fontFamily="Inter"
        android:layout_width="260dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: State -->
            <TextView
                android:text="✕ Sai"
                android:textSize="10sp"
                android:textColor="#FFF24057"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="58dp"
        android:layout_height="100dp"
        android:layout_marginStart="280dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- FRAME: Question review -->
        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="350dp"
        android:layout_height="74dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="592dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_rounded_box">

            <!-- TEXT: Question -->
            <TextView
                android:text="3. What does the Pomodoro technique involve?"
                android:textSize="11sp"
                android:textColor="#FF0F1729"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="285dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: Answer -->
            <TextView
                android:text="Đúng"
                android:textSize="10sp"
                android:textColor="#FF2EAB6B"
                android:gravity="start"
                android:fontFamily="Inter"
        android:layout_width="260dp"
        android:layout_height="100dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="34dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

            <!-- TEXT: State -->
            <TextView
                android:text="✓ Đúng"
                android:textSize="10sp"
                android:textColor="#FF2EAB6B"
                android:gravity="start"
                android:textStyle="bold"
                android:fontFamily="Inter"
        android:layout_width="58dp"
        android:layout_height="100dp"
        android:layout_marginStart="280dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>